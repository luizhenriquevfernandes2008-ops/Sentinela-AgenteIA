# Copie para .env e ajuste. O .env não vai para o git.

# Sem chave, o agente roda no modo "simulado" (grátis, sem internet).
# Com chave, roda no modo "real" usando o Claude.
ANTHROPIC_API_KEY=

# Força um modo: simulado | real (opcional)
# MODO_AGENTE=simulado

# Modelo e nível de esforço (low | medium | high | xhigh | max)
MODELO_CLAUDE=claude-opus-5
ESFORCO_CLAUDE=high

# Porta do servidor
PORTA=8000

# Chave que protege a API da loja (X-API-Key)
LOJA_API_KEY=dev-loja-123

# Senha do painel. Rodando só no seu computador, é opcional. Se o servidor
# ficar acessível de fora (HOST=0.0.0.0), é obrigatória (12+ caracteres).
# SENHA_OPERADOR=
