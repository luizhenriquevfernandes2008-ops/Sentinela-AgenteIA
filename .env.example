# Copie para .env e ajuste. O .env não vai para o git.

# Quem decide os passos do agente (MODO_AGENTE):
#   simulado = regras em Python, sem IA (padrão, grátis, sem internet)
#   groq     = IA de verdade, plano GRATUITO do Groq (precisa de GROQ_API_KEY)
#   claude   = IA de verdade, API do Claude, PAGA (precisa de ANTHROPIC_API_KEY)
# MODO_AGENTE=groq

# Chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODELO=openai/gpt-oss-120b

# Chave paga em https://console.anthropic.com
ANTHROPIC_API_KEY=
# Teto de gasto por dia com o Claude, em dólares (0 = nunca gastar)
# LIMITE_USD_DIA=1

# Modelo e nível de esforço (low | medium | high | xhigh | max)
MODELO_CLAUDE=claude-opus-5
ESFORCO_CLAUDE=high

# Porta do servidor
PORTA=8000

# Chave que protege a API da loja (X-API-Key)
LOJA_API_KEY=dev-loja-123

# Senha do painel. Rodando só no seu computador, é opcional. Se o servidor
# ficar acessível de fora (HOST=0.0.0.0), é obrigatória (12+ caracteres).
# SENHA_OPERADOR=
